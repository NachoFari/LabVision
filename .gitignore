# ==============================================================================
# LabVision - .gitignore (Clean & Essential Repository)
# ==============================================================================

# Python Byte-compiled & Optimized Files
__pycache__/
*.py[cod]
*$py.class
*.so

# Executables & Native Binaries
*.exe
*.dll
*.pyd

# Windows Scripts & Installers (distribuídos vía Releases, no en Git)
*.bat
*.vbs
*.ps1
*.iss
*.cmd

# C# Source & Build Artifacts (Launcher)
*.cs
*.csproj
*.sln
*.pdb
*.obj

# Accesos directos y enlaces
*.lnk

# Distribución y Empaquetado
dist/
build/
*.zip
*.tar.*
*.7z

# Entornos virtuales y Runtime portable
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
runtime/

# Suites de prueba y Benchmarks de desarrollo
benchmark/
tests/

# Modelos pesados de Deep Learning
models/

# Salida de mediciones e historial local
output/

# Archivos de configuración local y credenciales
config.json

# Logs y depuración
*.log
npm-debug.log*
yarn-debug.log*

# Videos y grabaciones de laboratorio de prueba
*.mp4
*.avi
*.mov
*.mkv
*.wmv

# Íconos de compilación en raíz (los del sistema residen en static/)
/fox.ico
/labvision.ico

# IDEs y Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Archivos del Sistema Operativo
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
